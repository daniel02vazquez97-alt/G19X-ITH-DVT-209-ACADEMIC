# Ejemplo de configuración local de la API V1 (U5, DT-064 y DT-065). VALORES FICTICIOS.
#
# No contiene secretos. Los tokens `dev-...` son identidades de desarrollo inventadas: solo se aceptan
# con APP_ENV=local, y la API rechaza arrancar con cualquier otro entorno. No reutilices estos valores
# fuera de tu máquina. Los archivos `.env` reales están excluidos por .gitignore.
#
# La aplicación no lee este archivo: exporta las variables en tu shell antes de lanzar, desde backend/,
#     python -m app.api            (sirve en http://127.0.0.1:8000; documentación en /docs)

# local | dev | staging | prod (obligatoria). Solo `local` arranca en la V1.
APP_ENV=local

# PostgreSQL local de infra/docker-compose.yml (autenticación trust, sin contraseña).
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/inventory

# JSON token → {subject_id, roles}. Token: ^dev-[A-Za-z0-9_-]{16,64}$; subject_id: ^[a-z0-9-]{1,64}$;
# roles: VIEWER, ANALYST, PLANNER, ADMIN (sin jerarquía: cada identidad declara los suyos).
DEV_AUTH_IDENTITIES={"dev-example-viewer-0000000000": {"subject_id": "example-viewer", "roles": ["VIEWER"]}, "dev-example-analyst-000000000": {"subject_id": "example-analyst", "roles": ["ANALYST"]}, "dev-example-planner-000000000": {"subject_id": "example-planner", "roles": ["PLANNER"]}, "dev-example-admin-00000000000": {"subject_id": "example-admin", "roles": ["ADMIN"]}}

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
