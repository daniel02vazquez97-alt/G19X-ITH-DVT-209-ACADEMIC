# U11 (DT-099): forma de la configuración de Entra ID en dev. VALORES FICTICIOS (GUID a cero).
#
# No hay secretos: son identificadores públicos (tenant, client ID de la API y de la SPA). Los valores reales
# los escribe infra/azure/deploy-u11.ps1 en tmp/u11-evidence/ (ignorado por Git):
#   entra-dev.env                    -> API (docker compose --env-file, o variables de entorno)
#   frontend.env.development.local   -> SPA con `npm run dev` (copiar a frontend/.env.development.local)

# --- API (backend) -----------------------------------------------------------------------------------
APP_ENV=dev
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/inventory
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# DEV_AUTH_IDENTITIES no debe existir (o debe estar vacía) con APP_ENV=dev: la API se niega a arrancar.

# --- SPA (frontend, variables de compilación de Vite; acaban en el JavaScript público) ----------------
VITE_APP_ENV=dev
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
